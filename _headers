# Cache rules for Cloudflare Pages / Netlify (ignored by hosts that don't read this file).
# Fonts never change, so they can be cached for a year. Images, CSS and JS are not
# fingerprinted yet, so they use a shorter cache with background revalidation.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/css/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
